# OpenRouter — model provider for all agents (root + subagents)
OPENROUTER_API_KEY=sk-or-...

# Browserless — hosted headless Chrome that runs axe-core / screenshots / computed styles.
# Token from your Browserless account (sent as Authorization: Bearer, not ?token=).
# Base URL is region-specific.
BROWSERLESS_TOKEN=
BROWSERLESS_URL=https://production-sfo.browserless.io

# Vision model (OpenRouter id) used by the heuristic-critic's critique_page tool.
VISION_MODEL=anthropic/claude-sonnet-4.6

# Optional: design tokens source (DTCG / Style Dictionary JSON URL) for the
# design-system-checker. Must be a public http(s) URL. If unset, that checker
# reports observed values only.
DESIGN_TOKENS_URL=

# Route auth (agent/channels/eve.ts uses httpBasic only when password is set).
# Empty password fail-closes on deploy (localDev still works for pnpm run dev).
ROUTE_AUTH_BASIC_USER=daniel
ROUTE_AUTH_BASIC_PASSWORD=

# GitHub MCP connection (slice 3) — PAT with Pull requests: read+write on target repos.
GITHUB_TOKEN=
# Optional override of the GitHub MCP server URL.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
